{
  "name": "weloop-components",
  "version": "2.1.0",
  "description": "WeLoop 2.1 — Figma-verified React component library with multi-brand design token system",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./components": "./src/components/index.ts",
    "./components/atoms": "./src/components/atoms/index.ts",
    "./icons": "./src/components/atoms/Icon/index.ts",
    "./bank-logos": "./src/components/atoms/BankLogo/index.ts",
    "./flags": "./src/components/atoms/Flag/index.ts",
    "./components/molecules": "./src/components/molecules/index.ts",
    "./components/organisms": "./src/components/organisms/index.ts"
  },
  "files": [
    "src/components",
    "src/tokens",
    "src/index.ts",
    "docs",
    "scripts/generate-docs.mjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "node scripts/generate-docs.mjs"
  },
  "keywords": [
    "weloop",
    "design-system",
    "react",
    "typescript",
    "ui-components",
    "tokens",
    "wabooks",
    "webill365",
    "wecafe"
  ],
  "author": "Products Operations Dept.",
  "license": "ISC",
