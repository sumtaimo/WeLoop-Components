{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/tokens/*": ["src/tokens/*"],
      "@/styles/*": ["src/styles/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*", "showcase/**/*", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
